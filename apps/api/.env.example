NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://eduvault:eduvault@localhost:5434/eduvault?sslmode=disable
BETTER_AUTH_SECRET=local-dev-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
