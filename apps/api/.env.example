NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://eduvault:eduvault@localhost:5434/eduvault?sslmode=disable
BETTER_AUTH_SECRET=local-dev-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ADMIN_URL=http://localhost:4200
WEB_PORTAL_URL=http://localhost:4201
# Optional ISO date that pins the seeded "today" (2026-10-07 reproduces the prototype)
# SEED_TODAY=2026-10-07
# Local e2e only: accept invitations without a verified email (there is no mail transport). Refused in production.
# E2E_TRUST_INVITEES=true
# Sign-in rate limit (5 per minute per IP and per email); always on in production
# AUTH_RATE_LIMIT=true
# Local only: the super admin that `nx run api:bootstrap-admin` creates and the seed signs in with
BOOTSTRAP_ADMIN_EMAIL=admin@eduvault.test
BOOTSTRAP_ADMIN_PASSWORD=password123
