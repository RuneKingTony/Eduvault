{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api"],
  "targets": {
    "typecheck": {},
    "env-init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "[ -f .env.local ] || cp .env.example .env.local",
        "cwd": "apps/api"
      }
    },
    "db-start": {
      "executor": "nx:run-commands",
      "description": "Start only Postgres (docker compose, host port 5434)",
      "options": {
        "command": "docker compose up -d --wait postgres"
      }
    },
    "db-stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose down"
      }
    },
    "db-migrate-up": {
      "executor": "nx:run-commands",
      "dependsOn": ["env-init"],
      "options": {
        "command": "pnpm exec dbmate --env-file .env.local --migrations-dir db/migrations --no-dump-schema up",
        "cwd": "apps/api"
      }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "description": "Wipe the local Postgres volume, restart it and re-apply migrations",
      "options": {
        "commands": [
          "docker compose down -v",
          "docker compose up -d --wait postgres",
          "nx run api:db-migrate-up"
        ],
        "parallel": false
      }
    },
    "seed-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist/seed.cjs",
        "{projectRoot}/dist/seed.cjs.map"
      ],
      "description": "Bundle the dev seed with SWC so Nest keeps its decorator metadata",
      "options": {
        "command": "vite build --config vite.seed.config.mts",
        "cwd": "apps/api"
      }
    },
    "db-seed": {
      "executor": "nx:run-commands",
      "dependsOn": ["env-init", "seed-build"],
      "description": "Seed the Greenfield dev data through the API's services (idempotent)",
      "options": {
        "command": "node --env-file=.env.local dist/seed.cjs",
        "cwd": "apps/api"
      }
    },
    "bootstrap-admin-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist/bootstrap-admin.cjs",
        "{projectRoot}/dist/bootstrap-admin.cjs.map"
      ],
      "description": "Bundle the bootstrap-admin command with SWC (no Nest)",
      "options": {
        "command": "vite build --config vite.bootstrap-admin.config.mts",
        "cwd": "apps/api"
      }
    },
    "bootstrap-admin": {
      "executor": "nx:run-commands",
      "dependsOn": ["env-init", "bootstrap-admin-build"],
      "description": "Create the super admin from BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD (idempotent)",
      "options": {
        "command": "node --env-file-if-exists=.env.local dist/bootstrap-admin.cjs",
        "cwd": "apps/api"
      }
    },
    "auth-generate": {
      "executor": "nx:run-commands",
      "description": "Emit Better Auth schema changes as a new dbmate migration and refresh the snapshot",
      "options": {
        "command": "tsx --tsconfig scripts/tsconfig.json scripts/drift-check.ts --write --only=auth"
      }
    },
    "db-codegen": {
      "executor": "nx:run-commands",
      "description": "Regenerate the committed Kysely types",
      "options": {
        "command": "tsx --tsconfig scripts/tsconfig.json scripts/drift-check.ts --write --only=types"
      }
    },
    "db-dump": {
      "executor": "nx:run-commands",
      "description": "Regenerate the committed db/schema.sql",
      "options": {
        "command": "tsx --tsconfig scripts/tsconfig.json scripts/drift-check.ts --write --only=schema"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "env-init"],
      "continuous": true,
      "description": "Build once, then rebuild on change and restart node on the new bundle (http://localhost:3000)",
      "options": {
        "cwd": "apps/api",
        "parallel": true,
        "commands": [
          "vite build --watch --emptyOutDir=false",
          "node --watch --env-file=.env.local dist/main.cjs"
        ]
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "description": "Integration tests against a real Postgres container (needs Docker)",
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "apps/api"
      }
    }
  }
}
