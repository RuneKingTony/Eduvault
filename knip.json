{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@nx/devkit",
        "@nx/js",
        "@nx/nest",
        "@nx/node",
        "@nx/react",
        "@eslint/js",
        "tailwindcss"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "auth.ts",
        "scripts/seed.ts",
        "test/**/*.integration.spec.ts",
        "test/setup/global-setup.ts",
        "vite.config.mts",
        "vite.seed.config.mts",
        "vitest.config.mts",
        "vitest.integration.config.mts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["src/db/db-types.ts"],
      "ignoreDependencies": ["auth", "kysely-codegen"]
    },
    "apps/web-admin": {
      "entry": ["src/main.tsx", "vite.config.mts", "vitest.config.mts"]
    },
    "apps/web-portal": {
      "entry": ["src/main.tsx", "vite.config.mts", "vitest.config.mts"]
    },
    "libs/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/ui": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/roboto",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "libs/testcontainers": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["dbmate"]
    }
  }
}
